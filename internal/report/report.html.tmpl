<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.App.Name}} · Magpie security report</title>
<style>
  :root {
    --bg: #ffffff; --ink: #1f2328; --muted: #59636e; --line: #d1d9e0; --soft: #f6f8fa;
    --critical: #8250df; --high: #cf222e; --medium: #9a6700; --low: #0969da; --info: #59636e;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0d1117; --ink: #e6edf3; --muted: #9198a1; --line: #30363d; --soft: #151b23;
      --critical: #ab7df8; --high: #f85149; --medium: #d29922; --low: #4493f8; --info: #9198a1; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink);
    font: 15px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  main { max-width: 860px; margin: 0 auto; padding: 40px 20px 72px; }
  a { color: inherit; }
  code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }

  .toolbar { display: flex; justify-content: space-between; margin-bottom: 32px; font-size: 14px; }
  .toolbar button { font: inherit; background: none; border: 0; padding: 0; color: var(--ink);
    text-decoration: underline; cursor: pointer; }

  .top { display: flex; justify-content: space-between; gap: 24px; align-items: flex-start;
    border-bottom: 2px solid var(--ink); padding-bottom: 20px; }
  .kicker { margin: 0; color: var(--muted); font-size: 13px; }
  h1 { margin: 6px 0 2px; font-size: 30px; line-height: 1.2; letter-spacing: -0.01em; }
  .grade { text-align: right; }
  .grade b { display: block; font-size: 56px; line-height: 1; }
  .grade span { color: var(--muted); font-size: 13px; }

  dl.meta { display: grid; grid-template-columns: max-content 1fr; gap: 4px 24px; margin: 20px 0 0; font-size: 14px; }
  dl.meta dt { color: var(--muted); }
  dl.meta dd { margin: 0; }

  h2 { font-size: 18px; margin: 40px 0 12px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 7px 10px 7px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 500; font-size: 13px; }
  td.n { color: var(--muted); width: 2.5em; }
  td a { text-decoration: none; }
  td a:hover { text-decoration: underline; }
  .counts { color: var(--muted); font-size: 14px; margin: 0 0 12px; }

  .sev { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .03em; }
  .critical { color: var(--critical); } .high { color: var(--high); } .medium { color: var(--medium); }
  .low { color: var(--low); } .info { color: var(--info); }

  section.finding { border-top: 1px solid var(--line); padding: 20px 0 8px; }
  section.finding h3 { margin: 0; font-size: 16px; }
  section.finding h3 .num { color: var(--muted); font-weight: 400; margin-right: 6px; }
  .line { margin: 4px 0 0; color: var(--muted); font-size: 13px; }
  section.finding p { margin: 10px 0; }
  .label { font-weight: 600; }
  pre { margin: 6px 0 12px; padding: 10px 12px; background: var(--soft); border: 1px solid var(--line);
    border-radius: 4px; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 12.5px; line-height: 1.5; }
  .none { padding: 24px 0; }

  footer { margin-top: 48px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }

  @media (max-width: 560px) { .top { flex-direction: column-reverse; } .grade { text-align: left; } }
  @media print {
    .toolbar { display: none; }
    section.finding { break-inside: avoid; }
    body { font-size: 12px; }
  }
</style>
</head>
<body>
<main>
  {{if .Interactive}}
  <div class="toolbar">
    <a href="/">Scan another app</a>
    <button type="button" id="save">Save this report</button>
  </div>
  {{end}}

  <div class="top">
    <div>
      <p class="kicker">Magpie security report</p>
      <h1>{{.App.Name}}</h1>
      <div class="mono">{{.App.BundleID}}</div>
    </div>
    <div class="grade">
      <b class="{{if or (eq .Grade "A") (eq .Grade "B")}}{{else if eq .Grade "C"}}medium{{else}}high{{end}}">{{.Grade}}</b>
      <span>{{.Score}} / 100</span>
    </div>
  </div>

  <dl class="meta">
    {{if .App.Version}}<dt>Version</dt><dd>{{.App.Version}}{{if .App.Build}} (build {{.App.Build}}){{end}}</dd>{{end}}
    {{if .App.MinOS}}<dt>Minimum iOS</dt><dd>{{.App.MinOS}}</dd>{{end}}
    {{if .App.Arch}}<dt>Architecture</dt><dd>{{.App.Arch}}</dd>{{end}}
    <dt>Binary</dt><dd>{{if .App.Encrypted}}FairPlay-encrypted (App Store download), code checks limited{{else}}Not encrypted{{end}}</dd>
    <dt>Scanned</dt><dd>{{.ScannedAt.Format "2 January 2006, 3:04 PM MST"}}</dd>
    <dt>Magpie</dt><dd>{{.Version}}</dd>
  </dl>

  <h2>Summary</h2>
  {{if .Findings}}
  <p class="counts">{{len .Findings}} findings: {{summary .Counts}}.</p>
  <table>
    <thead><tr><th>#</th><th>Severity</th><th>Finding</th><th>Rule</th></tr></thead>
    <tbody>
    {{range $i, $f := .Findings}}
      <tr>
        <td class="n">{{inc $i}}</td>
        <td><span class="sev {{sev $f.Severity}}">{{sev $f.Severity}}</span></td>
        <td><a href="#f{{inc $i}}">{{$f.Title}}</a></td>
        <td class="mono">{{$f.ID}}</td>
      </tr>
    {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="none">No issues found.</p>
  {{end}}

  {{if .Findings}}<h2>Details</h2>{{end}}
  {{range $i, $f := .Findings}}
  <section class="finding" id="f{{inc $i}}">
    <h3><span class="num">{{inc $i}}.</span>{{$f.Title}}</h3>
    <p class="line"><span class="sev {{sev $f.Severity}}">{{sev $f.Severity}}</span> · <span class="mono">{{$f.ID}}</span> · {{$f.Category}}{{if $f.MASVS}} · {{$f.MASVS}}{{end}}</p>
    <p>{{$f.Description}}</p>
    {{if $f.Evidence}}<div class="label">Evidence</div>
    <pre>{{range $j, $e := $f.Evidence}}{{if $j}}
{{end}}{{$e}}{{end}}</pre>{{end}}
    <p><span class="label">Recommendation.</span> {{$f.Remediation}}</p>
  </section>
  {{end}}

  <footer>
    Generated by <a href="https://github.com/Kumar-ranjan12345/magpie">Magpie</a>, a static scanner: it reads the built app and does not run it.
    Runtime protections are detected, not rated. Only scan apps you own or are authorised to test.
  </footer>
</main>
{{if .Interactive}}
<script>
  document.getElementById('save').addEventListener('click', function () {
    var copy = document.documentElement.cloneNode(true);
    copy.querySelectorAll('.toolbar, script').forEach(function (el) { el.remove(); });
    var blob = new Blob(['<!doctype html>\n' + copy.outerHTML], { type: 'text/html' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'magpie-' + {{.App.BundleID}} + '.html';
    a.click();
  });
</script>
{{end}}
</body>
</html>
