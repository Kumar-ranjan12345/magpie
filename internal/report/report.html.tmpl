<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.App.Name}} · Magpie security report</title>
<style>
  :root {
    --bg: #f6f8fa; --surface: #ffffff; --ink: #1f2328; --muted: #59636e; --line: #d1d9e0; --soft: #f6f8fa;
    --critical: #8250df; --high: #cf222e; --medium: #9a6700; --low: #0969da; --info: #59636e;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0d1117; --surface: #151b23; --ink: #e6edf3; --muted: #9198a1; --line: #30363d; --soft: #0d1117;
      --critical: #ab7df8; --high: #f85149; --medium: #d29922; --low: #4493f8; --info: #9198a1; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink);
    font: 15px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  main { max-width: 900px; margin: 0 auto; padding: 36px 20px 72px; }
  a { color: inherit; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }

  .toolbar { display: flex; justify-content: space-between; margin-bottom: 28px; font-size: 14px; }
  .toolbar button { font: inherit; background: none; border: 0; padding: 0; color: var(--ink);
    text-decoration: underline; cursor: pointer; }

  header { display: flex; justify-content: space-between; gap: 24px; align-items: flex-start; }
  .kicker { margin: 0; color: var(--muted); font-size: 13px; display: flex; align-items: center; gap: 8px; }
  .logo svg { width: 22px; height: 22px; display: block; }
  h1 { margin: 4px 0 2px; font-size: 28px; line-height: 1.2; }
  .grade { min-width: 112px; text-align: center; border: 1px solid var(--line); border-radius: 6px;
    background: var(--surface); padding: 10px 14px; }
  .grade small { display: block; color: var(--muted); font-size: 12px; }
  .grade b { display: block; font-size: 44px; line-height: 1.1; }

  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin: 24px 0 12px; }
  .meta div { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 8px 12px; font-size: 14px; }
  .meta span { display: block; font-size: 12px; color: var(--muted); }
  .explain { color: var(--muted); font-size: 13px; margin: 0 0 24px; }

  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 16px; }
  .filters button { border: 1px solid var(--line); background: var(--surface); color: var(--muted);
    border-radius: 6px; padding: 4px 12px; font: inherit; font-size: 13px; cursor: pointer; }
  .filters button[aria-pressed="true"] { color: var(--ink); border-color: var(--muted); font-weight: 600; }

  .finding { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 16px 20px; margin-bottom: 12px; }
  .finding .line { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 12.5px; color: var(--muted); }
  .sev { font-weight: 600; text-transform: uppercase; letter-spacing: .03em; }
  .critical .sev { color: var(--critical); } .high .sev { color: var(--high); } .medium .sev { color: var(--medium); }
  .low .sev { color: var(--low); } .info .sev { color: var(--info); }
  .finding h2 { margin: 4px 0 0; font-size: 16px; }
  .finding p { margin: 8px 0; }
  .finding .why { color: var(--muted); }
  pre { margin: 8px 0; padding: 8px 12px; background: var(--soft); border: 1px solid var(--line); border-radius: 4px;
    white-space: pre-wrap; overflow-wrap: anywhere; font-size: 12.5px; line-height: 1.5; }
  .fix b { font-weight: 600; }
  .none { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 32px; text-align: center; }

  footer { margin-top: 40px; color: var(--muted); font-size: 13px; }

  @media (max-width: 560px) { header { flex-direction: column; } }
  @media print {
    body { background: #fff; }
    .toolbar, .filters { display: none; }
    .finding { break-inside: avoid; }
  }
</style>
</head>
<body>
<main>
  {{if .Interactive}}
  <div class="toolbar">
    <a href="/">Scan another app</a>
    <button type="button" id="save">Save this report</button>
  </div>
  {{end}}

  <header>
    <div>
      <p class="kicker"><span class="logo">{{icon}}</span>Magpie security report</p>
      <h1>{{.App.Name}}</h1>
      <div class="mono">{{.App.BundleID}}</div>
    </div>
    <div class="grade">
      <small>Security grade</small>
      <b>{{.Grade}}</b>
      <small>{{.Score}} / 100</small>
    </div>
  </header>

  <section class="meta">
    {{if .App.Version}}<div><span>Version</span>{{.App.Version}}{{if .App.Build}} ({{.App.Build}}){{end}}</div>{{end}}
    {{if .App.MinOS}}<div><span>Minimum iOS</span>{{.App.MinOS}}</div>{{end}}
    {{if .App.Arch}}<div><span>Architecture</span>{{.App.Arch}}</div>{{end}}
    <div><span>Encrypted</span>{{if .App.Encrypted}}Yes, App Store binary{{else}}No{{end}}</div>
    <div><span>Scanned</span>{{.ScannedAt.Format "2 Jan 2006, 3:04 PM MST"}}</div>
  </section>

  <p class="explain">The grade starts at 100 and each finding takes points off: critical 30, high 15, medium 8, low 3, info 0.
    90+ is A, 80+ B, 65+ C, 50+ D, below that F. Any critical finding caps the grade at D and any high finding at C.</p>

  {{if .Findings}}
  <nav class="filters" aria-label="Filter by severity">
    <button type="button" data-filter="all" aria-pressed="true">All {{len .Findings}}</button>
    {{range .Severities}}{{$n := count $.Counts .}}{{if $n}}<button type="button" data-filter="{{.}}" aria-pressed="false">{{title .}} {{$n}}</button>{{end}}{{end}}
  </nav>
  {{else}}
  <div class="none">No issues found.</div>
  {{end}}

  {{range .Findings}}
  <article class="finding {{sev .Severity}}" data-severity="{{sev .Severity}}">
    <div class="line">
      <span class="sev">{{sev .Severity}}</span>
      <span class="mono">{{.ID}}</span>
      <span>{{.Category}}{{if .MASVS}} · {{.MASVS}}{{end}}</span>
    </div>
    <h2>{{.Title}}</h2>
    <p class="why">{{.Description}}</p>
    {{if .Evidence}}<pre>{{range $j, $e := .Evidence}}{{if $j}}
{{end}}{{$e}}{{end}}</pre>{{end}}
    <p class="fix"><b>Fix:</b> {{.Remediation}}</p>
  </article>
  {{end}}

  <footer>
    Generated by <a href="https://github.com/Kumar-ranjan12345/magpie">Magpie</a> {{.Version}}. Magpie reads the built app and does not run it,
    so runtime protections are detected, not rated. Only scan apps you own or are authorised to test.
  </footer>
</main>
<script>
  document.querySelectorAll('.filters button').forEach(function (b) {
    b.addEventListener('click', function () {
      var f = b.dataset.filter;
      document.querySelectorAll('.filters button').forEach(function (x) { x.setAttribute('aria-pressed', x === b); });
      document.querySelectorAll('.finding').forEach(function (el) {
        el.hidden = f !== 'all' && el.dataset.severity !== f;
      });
    });
  });
  var save = document.getElementById('save');
  if (save) save.addEventListener('click', function () {
    var copy = document.documentElement.cloneNode(true);
    var bar = copy.querySelector('.toolbar');
    if (bar) bar.remove();
    var blob = new Blob(['<!doctype html>\n' + copy.outerHTML], { type: 'text/html' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'magpie-' + {{.App.BundleID}} + '.html';
    a.click();
  });
</script>
</body>
</html>
