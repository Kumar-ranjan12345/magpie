<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{.App.Name}} · Magpie security report</title>
<style>
  :root {
    color-scheme: light;
    --bg: #f6f6f3; --surface: #ffffff; --soft: #f1f1ed; --ink: #1b1f2a; --muted: #5f6573; --line: #e2e2dc;
    --brand: #15172a; --brand-ink: #f5f6f8; --brand-muted: #a3aab8; --brand-line: #2b3242;
    --accent: #5b4ee6; --accent-hover: #4a3dd4; --accent-soft: #f1efff; --gold: #c9971a;
    --critical: #9333ea; --high: #d1242f; --medium: #b35900; --low: #2f6fdc; --info: #8a8f99;
    --bad: #d1242f; --good: #1f8a4c;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink);
    font: 15px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  a { color: inherit; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }

  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 24px;
    background: var(--brand); color: var(--brand-ink); }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; }
  .brand svg { width: 26px; height: 26px; display: block; border-radius: 6px; }
  .brand small { color: var(--brand-muted); font-weight: 400; font-size: 13px; }
  .actions { display: flex; gap: 8px; }
  .btn { font: inherit; font-size: 14px; padding: 5px 14px; border-radius: 6px; border: 1px solid var(--brand-line);
    background: transparent; color: var(--brand-ink); cursor: pointer; text-decoration: none; }
  .btn:hover { border-color: var(--brand-muted); }
  .btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); font-weight: 600; }
  .btn.primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); }

  main { max-width: 920px; margin: 0 auto; padding: 32px 20px 72px; }

  .top { display: flex; justify-content: space-between; gap: 24px; align-items: stretch; }
  .kicker { margin: 0; color: var(--accent); font-size: 13px; font-weight: 600; }
  h1 { margin: 4px 0 2px; font-size: 30px; line-height: 1.2; letter-spacing: -0.01em; }
  .grade { display: flex; align-items: center; gap: 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface);
    padding: 12px 18px 12px 14px; border-top: 3px solid var(--g); }
  .grade b { font-size: 46px; line-height: 1; min-width: 40px; text-align: center; color: var(--g); }
  .grade div { font-size: 13px; color: var(--muted); line-height: 1.4; }
  .grade div strong { display: block; color: var(--ink); font-size: 14px; }
  .g-good { --g: var(--good); } .g-mid { --g: var(--medium); } .g-bad { --g: var(--high); }

  .meta { display: grid; grid-template-columns: repeat(5, auto); border: 1px solid var(--line); border-radius: 12px; background: var(--surface);
    margin: 24px 0 10px; }
  .meta div { padding: 10px 16px; font-size: 14px; white-space: nowrap; }
  .meta div + div { border-left: 1px solid var(--line); }
  .meta span { display: block; font-size: 12px; color: var(--muted); }
  details.how { font-size: 13px; color: var(--muted); margin: 0 0 28px; }
  details.how summary { cursor: pointer; width: max-content; color: var(--accent); }
  details.how p { margin: 6px 0 0; max-width: 720px; }

  .overview { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .overview h2 { font-size: 18px; margin: 0; }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; }
  .filters button { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line); background: var(--surface);
    color: var(--muted); border-radius: 999px; padding: 3px 12px; font: inherit; font-size: 13px; cursor: pointer; }
  .filters button[aria-pressed="true"] { color: #fff; border-color: var(--accent); background: var(--accent); font-weight: 600; }
  .filters button[aria-pressed="true"] .dot { box-shadow: 0 0 0 1.5px #fff; }
  .filters button:hover { border-color: var(--accent); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--sev, var(--muted)); flex: none; }

  .critical { --sev: var(--critical); } .high { --sev: var(--high); } .medium { --sev: var(--medium); }
  .low { --sev: var(--low); } .info { --sev: var(--info); }

  .finding { border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; margin-bottom: 12px; background: var(--surface);
    box-shadow: 0 1px 2px rgba(21,23,42,.04); }
  .finding:target { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .finding .head { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .finding h3 { margin: 0; font-size: 16px; line-height: 1.4; }
  .finding .id { color: var(--muted); white-space: nowrap; }
  .finding .line { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin-top: 4px; font-size: 13px; color: var(--muted); }
  .sev { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 12px; text-transform: uppercase;
    letter-spacing: .04em; color: var(--sev); }
  .finding p { margin: 10px 0; }
  .finding .why { color: var(--muted); }
  .label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin-top: 12px; }
  pre { margin: 6px 0 0; padding: 10px 12px; background: var(--soft); border: 1px solid var(--line); border-radius: 6px;
    white-space: pre-wrap; overflow-wrap: anywhere; font-size: 12.5px; line-height: 1.55; }
  .fix { margin-top: 12px; padding: 10px 12px; border-radius: 6px; background: #eef7f1; border-left: 3px solid var(--good); }
  .fix .label { margin: 0 0 2px; color: var(--good); }
  .none { border: 1px solid var(--line); border-radius: 12px; padding: 40px; text-align: center; background: var(--surface); }
  .none b { display: block; font-size: 18px; color: var(--good); }

  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }

  @media (max-width: 720px) {
    .top { flex-direction: column; }
    .grade { align-self: flex-start; }
    .meta { grid-template-columns: repeat(2, 1fr); }
    .meta div { white-space: normal; border-top: 1px solid var(--line); }
    .meta div + div { border-left: 0; }
    .meta div:nth-child(-n+2) { border-top: 0; }
    .meta div:nth-child(even) { border-left: 1px solid var(--line); }
    .finding .head { flex-direction: column; gap: 2px; }
  }
  @media print {
    .bar .actions, .filters { display: none; }
    .finding { break-inside: avoid; }
  }
</style>
</head>
<body>
<header class="bar">
  <div class="brand">{{icon}} Magpie <small>{{.Version}}</small></div>
  {{if .Interactive}}
  <div class="actions">
    <a class="btn" href="/">Scan another app</a>
    <button class="btn primary" type="button" id="save">Save report</button>
  </div>
  {{end}}
</header>

<main>
  <div class="top">
    <div>
      <p class="kicker">Security report</p>
      <h1>{{.App.Name}}</h1>
      <div class="mono">{{.App.BundleID}}</div>
    </div>
    <div class="grade {{gradeClass .Grade}}" title="Security grade">
      <b>{{.Grade}}</b>
      <div><strong>Security grade</strong>{{.Score}} / 100 · {{len .Findings}} findings</div>
    </div>
  </div>

  <section class="meta">
    <div><span>Version</span>{{if .App.Version}}{{.App.Version}}{{if .App.Build}} ({{.App.Build}}){{end}}{{else}}–{{end}}</div>
    <div><span>Minimum iOS</span>{{if .App.MinOS}}{{.App.MinOS}}{{else}}–{{end}}</div>
    <div><span>Architecture</span>{{if .App.Arch}}{{.App.Arch}}{{else}}–{{end}}</div>
    <div><span>Encrypted</span>{{if .App.Encrypted}}Yes (App Store){{else}}No{{end}}</div>
    <div><span>Scanned</span>{{.ScannedAt.Format "2 Jan 2006, 3:04 PM MST"}}</div>
  </section>

  <details class="how">
    <summary>How is the grade calculated?</summary>
    <p>It starts at 100 and each finding takes points off: critical 30, high 15, medium 8, low 3, info 0.
      90 and above is A, 80 B, 65 C, 50 D, anything lower F. Any critical finding caps the grade at D
      and any high finding at C, so a single serious issue can't hide behind an otherwise clean app.</p>
  </details>

  {{if .Findings}}
  <div class="overview">
    <h2>Findings</h2>
    <nav class="filters" aria-label="Filter by severity">
      <button type="button" data-filter="all" aria-pressed="true">All {{len .Findings}}</button>
      {{range .Severities}}{{$n := count $.Counts .}}{{if $n}}<button type="button" class="{{.}}" data-filter="{{.}}" aria-pressed="false"><span class="dot"></span>{{title .}} {{$n}}</button>{{end}}{{end}}
    </nav>
  </div>
  {{else}}
  <div class="none"><b>No issues found</b>Magpie didn't find anything to report in this build.</div>
  {{end}}

  {{range .Findings}}
  <article class="finding {{sev .Severity}}" data-severity="{{sev .Severity}}">
    <div class="head">
      <h3>{{.Title}}</h3>
      <span class="id mono">{{.ID}}</span>
    </div>
    <div class="line">
      <span class="sev"><span class="dot"></span>{{sev .Severity}}</span>
      <span>{{.Category}}</span>
      {{if .MASVS}}<span class="mono">{{.MASVS}}</span>{{end}}
    </div>
    <p class="why">{{.Description}}</p>
    {{if .Evidence}}<div class="label">Evidence</div>
    <pre>{{range $j, $e := .Evidence}}{{if $j}}
{{end}}{{$e}}{{end}}</pre>{{end}}
    <div class="fix"><div class="label">How to fix</div>{{.Remediation}}</div>
  </article>
  {{end}}

  <footer>
    Generated by <a href="https://github.com/Kumar-ranjan12345/magpie">Magpie</a> {{.Version}}. Magpie reads the built app and does not run it,
    so runtime protections are detected, not rated. Only scan apps you own or are authorised to test.
  </footer>
</main>
<script>
  document.querySelectorAll('.filters button').forEach(function (b) {
    b.addEventListener('click', function () {
      var f = b.dataset.filter;
      document.querySelectorAll('.filters button').forEach(function (x) { x.setAttribute('aria-pressed', x === b); });
      document.querySelectorAll('.finding').forEach(function (el) {
        el.hidden = f !== 'all' && el.dataset.severity !== f;
      });
    });
  });
  var save = document.getElementById('save');
  if (save) save.addEventListener('click', function () {
    var copy = document.documentElement.cloneNode(true);
    var actions = copy.querySelector('.actions');
    if (actions) actions.remove();
    var blob = new Blob(['<!doctype html>\n' + copy.outerHTML], { type: 'text/html' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'magpie-' + {{.App.BundleID}} + '.html';
    a.click();
  });
</script>
</body>
</html>
